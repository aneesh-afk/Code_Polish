{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repo-up.local/schemas/run_record.schema.json",
  "title": "Repo-Up Evidence Study Run Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id", "task_id", "arm_id", "repeat_index", "attempt_index",
    "protocol_version", "repo_up_revision", "model_id", "model_revision",
    "prompt_sha256", "context_sha256", "applicability_status", "generation_status",
    "patch_status", "security_status", "functional_test_status", "semantic_audit_status",
    "input_tokens", "output_tokens", "model_calls", "wall_seconds", "started_at_utc"
  ],
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "arm_id": {"enum": ["A0", "A1", "A2", "A3", "A4", "A5", "A6", "A7"]},
    "repeat_index": {"type": "integer", "minimum": 1},
    "attempt_index": {"type": "integer", "minimum": 1},
    "protocol_version": {"type": "string", "minLength": 1},
    "repo_up_revision": {"type": ["string", "null"]},
    "benchmark_revision": {"type": ["string", "null"]},
    "model_id": {"type": ["string", "null"]},
    "model_revision": {"type": ["string", "null"]},
    "inference_stack": {"type": ["string", "null"]},
    "quantization_artifact_sha256": {"type": ["string", "null"], "pattern": "^[a-fA-F0-9]{64}$"},
    "prompt_sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "context_sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "applicability_status": {"enum": ["APPLICABLE", "NOT_APPLICABLE"]},
    "applicability_reason": {"type": "string"},
    "generation_status": {"enum": ["SUCCESS", "ABSTAIN", "ERROR", "TIMEOUT", "NOT_RUN"]},
    "patch_status": {"enum": ["EMPTY", "MALFORMED", "NO_OP", "REJECTED", "APPLY_FAILED", "APPLIED", "NOT_APPLICABLE", "NOT_RUN"]},
    "security_status": {"enum": ["PASS", "FAIL", "TIMEOUT", "ERROR", "NOT_AVAILABLE", "NOT_APPLICABLE", "NOT_RUN"]},
    "functional_test_status": {"enum": ["PASS", "FAIL", "TIMEOUT", "ERROR", "NOT_AVAILABLE", "NOT_APPLICABLE", "NOT_RUN"]},
    "semantic_audit_status": {"enum": ["CORRECT", "INCOMPLETE", "INCORRECT", "OVERFIT", "REGRESSION", "UNASSESSABLE", "PENDING", "NOT_APPLICABLE"]},
    "input_tokens": {"type": "integer", "minimum": 0},
    "output_tokens": {"type": "integer", "minimum": 0},
    "model_calls": {"type": "integer", "minimum": 0},
    "wall_seconds": {"type": "number", "minimum": 0},
    "gpu_seconds": {"type": ["number", "null"], "minimum": 0},
    "runtime_seconds": {"type": ["number", "null"], "minimum": 0},
    "retry_count": {"type": "integer", "minimum": 0},
    "failure_category": {"type": ["string", "null"]},
    "patch_sha256": {"type": ["string", "null"], "pattern": "^[a-fA-F0-9]{64}$"},
    "evaluator_image_digest": {"type": ["string", "null"]},
    "randomization_seed": {"type": ["integer", "null"]},
    "started_at_utc": {"type": "string", "format": "date-time"},
    "finished_at_utc": {"type": ["string", "null"], "format": "date-time"},
    "notes": {"type": "string"}
  }
}
